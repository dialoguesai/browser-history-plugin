{
  "manifest_version": 3,
  "name": "Dialogues Browser History",
  "version": "3.1.0",
  "description": "Send browsing history to your Topos via Dialogues Grant Access.",
  "permissions": [
    "identity",
    "webNavigation",
    "storage",
    "tabs",
    "notifications",
    "contextMenus",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/toolbar-16.png",
    "32": "icons/toolbar-32.png",
    "48": "icons/toolbar-48.png",
    "128": "icons/toolbar-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "20": "icons/toolbar-20.png",
      "24": "icons/toolbar-24.png",
      "32": "icons/toolbar-32.png",
      "40": "icons/toolbar-40.png",
      "48": "icons/toolbar-48.png",
      "64": "icons/toolbar-64.png",
      "128": "icons/toolbar-128.png"
    },
    "default_title": "Dialogues Browser Activity",
    "default_popup": "controller.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "120",
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "lib/skipDomains.js",
        "lib/config.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "options.html"
      ],
      "matches": [
        "https://cp.logu3s.com/*"
      ]
    }
  ]
}
